# systemd unit wrapping the Compose deployment at deploy/docker-compose.yml.
#
# Install: copy this file to /etc/systemd/system/zinder.service, then run
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zinder
#
# The pinned release checkout is expected at /opt/zinder; adjust
# WorkingDirectory below if your operator-chosen layout differs.
#
# /etc/zinder/deploy.env is a copy of one deploy/profiles/<name>/deploy.env
# file with DEPLOY_ZINDER_ENV=/etc/zinder/zinder.env (copied from the matching
# zinder.env) and optional writer-only DEPLOY_INDEX_ENV=/etc/zinder/index.env.
# DEPLOY_NETWORK names the Compose project, so Compose refuses to run when it
# is unset. Optionally set COMPOSE_PROFILES=observability in
# /etc/zinder/deploy.env to include Prometheus and Grafana.

[Unit]
Description=Zinder Zcash indexer (Compose topology)
Documentation=https://github.com/ZcashFoundation/zinder
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/zinder/deploy
EnvironmentFile=-/etc/zinder/deploy.env

# `docker compose up --no-build` blocks while the topology runs, so Type=simple
# is correct. `--no-build` avoids unintended image builds during unit restarts,
# and ExecStop tears down the topology on explicit stop without wiping an
# active non-resumable sync before startup.
ExecStart=/usr/bin/docker compose --env-file /etc/zinder/deploy.env -f docker-compose.yml up --no-build
ExecStop=/usr/bin/docker compose --env-file /etc/zinder/deploy.env -f docker-compose.yml down

Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=600

# Tighten the systemd sandbox without breaking docker's own capabilities.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
