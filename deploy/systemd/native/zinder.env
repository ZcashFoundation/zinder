# Shared configuration for the native services. Keep this file root-owned.
ZINDER_NETWORK__NAME=zcash-mainnet
ZINDER_DEPLOYMENT__PROFILE=wallet
ZINDER_STORAGE__DATA_DIR=/var/lib/zinder
ZINDER_PROJECTOR__LEASE_DURATION_SECONDS=14400

ZINDER_NODE__JSON_RPC_ADDR=http://127.0.0.1:8232
ZINDER_NODE__AUTH__METHOD=cookie
ZINDER_NODE__AUTH__PATH=/etc/zinder/native/node.cookie

ZINDER_SECURITY__ALLOW_PUBLIC_BIND=false
ZINDER_INGEST_CONTROL__LISTEN_ADDR=127.0.0.1:9100
ZINDER_INGEST_CONTROL__ADDR=http://127.0.0.1:9100
ZINDER_INGEST_CONTROL__BEARER_TOKEN_PATH=/etc/zinder/native/ingest.token
ZINDER_INGEST_CONTROL__CHECKPOINT_BEARER_TOKEN_PATH=/etc/zinder/native/checkpoint.token
ZINDER_PROJECTOR_CONTROL__LISTEN_ADDR=127.0.0.1:9101
ZINDER_PROJECTOR_CONTROL__BEARER_TOKEN_PATH=/etc/zinder/native/checkpoint.token
ZINDER_QUERY__LISTEN_ADDR=127.0.0.1:9102
ZINDER_COMPAT__LISTEN_ADDR=127.0.0.1:9067
ZINDER_EXPLORER__LISTEN_ADDR=127.0.0.1:9068
ZINDER_EXPLORER__WALLET_QUERY_ENDPOINT=http://127.0.0.1:9102
ZINDER_CIPHERSCAN__LISTEN_ADDR=127.0.0.1:9070
ZINDER_CIPHERSCAN__EXPLORER_QUERY_ENDPOINT=http://127.0.0.1:9068
