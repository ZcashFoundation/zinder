# Host and Compose orchestration for Zebra mainnet attachment through Z3.
# Use with:
#
#   docker compose --env-file deploy/profiles/mainnet/deploy.env -f deploy/docker-compose.yml up -d
#
# Requires Z3 mainnet to be running first (the `z3-mainnet` external network
# and `z3-mainnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3. For a Zakura node, use
# deploy/profiles/zakura-mainnet/deploy.env instead; both profiles describe the
# same Zinder deployment and share the Compose project, volumes, and host ports.
#
# Mainnet uses the canonical (no-offset) host ports from the compose file.
# Testnet adds +10000 (see deploy/profiles/testnet/deploy.env); regtest adds
# +20000. Setting them explicitly here documents the canonical port matrix.

DEPLOY_NETWORK=mainnet
DEPLOY_NODE_NETWORK=z3-mainnet
DEPLOY_NODE_COOKIE_VOLUME=z3-mainnet-cookie
# Relative env_file paths resolve from deploy/ (where docker-compose.yml lives).
DEPLOY_ZINDER_ENV=./profiles/mainnet/zinder.env

# Root-owned host directories; see deploy/README.md and docs/runbooks/deploying-on-a-vm.md.
DEPLOY_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, explorer, and private ops ports (canonical, no offset).
DEPLOY_INDEX_OPS_HOST_PORT=9105
DEPLOY_SERVE_OPS_HOST_PORT=9108
DEPLOY_QUERY_HOST_PORT=9102
DEPLOY_COMPAT_HOST_PORT=9067
DEPLOY_EXPLORER_HOST_PORT=9068
DEPLOY_CIPHERSCAN_HOST_PORT=9070

# Observability host ports (canonical, no offset).
DEPLOY_PROMETHEUS_HOST_PORT=9095
DEPLOY_GRAFANA_HOST_PORT=3002

# Container memory ceilings (cgroup guardrails).
# On 64+ GiB public Mainnet endpoints serving high-concurrency range scans,
# raise DEPLOY_SERVE_MEMORY_LIMIT (for example 32g+) so OS page cache keeps
# canonical ZSHRNG02 settled shielded segments resident.
DEPLOY_INDEX_MEMORY_LIMIT=20g
DEPLOY_SERVE_MEMORY_LIMIT=8g
DEPLOY_PROMETHEUS_MEMORY_LIMIT=1g
DEPLOY_GRAFANA_MEMORY_LIMIT=512m

# Optional overrides:
# DEPLOY_INDEX_ENV=./profiles/mainnet/index.env
# DEPLOY_VERSION=v0.28.0
# DEPLOY_IMAGE=ghcr.io/zcashfoundation/zinder:local
# DEPLOY_GRAFANA_ADMIN_PASSWORD=admin
