# Zinder runtime configuration for Zebra testnet attachment through Z3.
# Loaded into both `zinder-index` and `zinder-serve` via Compose `env_file:`.
# Keep DEPLOY_* host orchestration variables out of this file, and omit unset
# optional variables (empty `KEY=` values are rejected by Zinder).

ZINDER_DEPLOYMENT__PROFILE=wallet
ZINDER_NETWORK__NAME=zcash-testnet
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:18232
ZINDER_NODE__AUTH__METHOD=cookie
ZINDER_NODE__AUTH__PATH=/var/run/auth/.cookie

# Omitting ZINDER_NODE__INDEXER_GRPC_ADDR (or setting "none") selects JSON-RPC
# mempool polling. Stock Z3 does not start Zebra's indexer gRPC listener. To
# stream mempool events instead, set ZEBRA_RPC__INDEXER_LISTEN_ADDR=0.0.0.0:18155
# in the Z3 .env file, configure ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:18155,
# and set ZINDER_INGEST__SOURCE=zebra-indexer-grpc in writer-only index.env
# pointed to by DEPLOY_INDEX_ENV:
# ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:18155

# Optional runtime overrides:
# ZINDER_STORAGE__FULL_BLOCKS=true
# ZINDER_COMPAT__BROWSER_ORIGINS=https://wallet.example
