# Host and Compose orchestration for Zebra testnet attachment through Z3.
# Use with:
#
#   docker compose --env-file deploy/profiles/testnet/deploy.env -f deploy/docker-compose.yml up -d
#
# Requires Z3 testnet to be running first (the `z3-testnet` external network
# and `z3-testnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3. For a Zakura node, use
# deploy/profiles/zakura-testnet/deploy.env instead; both profiles describe the
# same Zinder deployment and share the Compose project, volumes, and host ports.
#
# Host ports are offset by +10000 vs the compose mainnet defaults so the two
# zinder flavours coexist on one host (mirrors the convention Zebra itself
# uses, 8232 vs 18232, and the offset z3 applies in .env.testnet).

DEPLOY_NETWORK=testnet
DEPLOY_NODE_NETWORK=z3-testnet
DEPLOY_NODE_COOKIE_VOLUME=z3-testnet-cookie
# Relative env_file paths resolve from deploy/ (where docker-compose.yml lives).
DEPLOY_ZINDER_ENV=./profiles/testnet/zinder.env

# Root-owned host directories; see deploy/README.md and docs/runbooks/deploying-on-a-vm.md.
DEPLOY_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, explorer, and private ops ports (+10000 offset).
DEPLOY_INDEX_OPS_HOST_PORT=19105
DEPLOY_SERVE_OPS_HOST_PORT=19108
DEPLOY_QUERY_HOST_PORT=19102
DEPLOY_COMPAT_HOST_PORT=19067
DEPLOY_EXPLORER_HOST_PORT=19068
DEPLOY_CIPHERSCAN_HOST_PORT=19070

# Observability host ports (+10000 offset).
DEPLOY_PROMETHEUS_HOST_PORT=19095
DEPLOY_GRAFANA_HOST_PORT=13002

# Container memory ceilings (cgroup guardrails).
DEPLOY_INDEX_MEMORY_LIMIT=12g
DEPLOY_SERVE_MEMORY_LIMIT=4g
DEPLOY_PROMETHEUS_MEMORY_LIMIT=1g
DEPLOY_GRAFANA_MEMORY_LIMIT=512m

# Optional overrides:
# DEPLOY_INDEX_ENV=./profiles/testnet/index.env
# DEPLOY_VERSION=v0.29.0
# DEPLOY_IMAGE=ghcr.io/zcashfoundation/zinder:local
# DEPLOY_GRAFANA_ADMIN_PASSWORD=admin
