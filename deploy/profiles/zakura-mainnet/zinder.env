# Zinder runtime configuration for Zakura mainnet attachment.
# Loaded into both `zinder-index` and `zinder-serve` via Compose `env_file:`.
# Keep DEPLOY_* host orchestration variables out of this file, and omit unset
# optional variables (empty `KEY=` values are rejected by Zinder).

ZINDER_DEPLOYMENT__PROFILE=wallet
ZINDER_NETWORK__NAME=zcash-mainnet
ZINDER_NODE__JSON_RPC_ADDR=http://zakura:8232
ZINDER_NODE__AUTH__METHOD=cookie
ZINDER_NODE__AUTH__PATH=/var/run/auth/.cookie

# Omitting ZINDER_NODE__INDEXER_GRPC_ADDR (or setting "none") selects JSON-RPC
# mempool polling. Zakura refuses a plaintext indexer gRPC listener on a
# non-loopback address, so a Zakura node in another container can serve the
# indexer stream only over TLS.
#
# Writer-only ZINDER_NODE__INDEXER_TLS__* settings (SERVER_NAME, CA_CERT_PEM,
# CLIENT_CERT_PEM, CLIENT_KEY_PEM) and ZINDER_INGEST__SOURCE belong in a
# separate writer-only index.env pointed to by DEPLOY_INDEX_ENV (never in this
# shared zinder.env, because `zinder serve --readers-only` rejects writer-only
# secrets in its environment):
# ZINDER_NODE__INDEXER_GRPC_ADDR=https://zakura:8230

# Optional runtime overrides:
# ZINDER_STORAGE__FULL_BLOCKS=true
# ZINDER_COMPAT__BROWSER_ORIGINS=https://wallet.example
