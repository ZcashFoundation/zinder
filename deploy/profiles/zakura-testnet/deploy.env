# Host and Compose orchestration for Zakura testnet attachment.
# Use with:
#
#   docker compose --env-file deploy/profiles/zakura-testnet/deploy.env -f deploy/docker-compose.yml up -d
#
# This profile and deploy/profiles/testnet/deploy.env describe the same Zinder
# testnet deployment: the Compose project, volumes, and host ports are shared,
# so switching nodes keeps the existing stores.
#
# Zakura's own Compose file shares neither a network nor a cookie volume with
# other projects. Start the node with:
#
# - ZAKURA_RPC__LISTEN_ADDR=0.0.0.0:18232, with the node attached to an
#   external Docker network shared with Zinder and reachable there as `zakura`.
# - ZAKURA_RPC__COOKIE_DIR=/var/run/auth on a dedicated named volume. Stock
#   Zakura keeps the cookie in its chain-state volume, which Zinder must not
#   mount.
# - network.zakura.listen_addr (ZAKURA_NETWORK__ZAKURA__LISTEN_ADDR) set
#   deliberately. When it is unset, Zakura's QUIC peer listener binds
#   0.0.0.0:8234.
#
# Zakura writes the cookie as UID 10001 with mode 0600. The Zinder image runs
# as UID 10001 too, so it reads it as written.
#
# Host ports carry the same +10000 testnet offset as deploy/profiles/testnet/deploy.env.

DEPLOY_NETWORK=testnet
# Set these two names to the ones the node uses.
DEPLOY_NODE_NETWORK=zakura-testnet
DEPLOY_NODE_COOKIE_VOLUME=zakura-testnet-cookie
# Relative env_file paths resolve from deploy/ (where docker-compose.yml lives).
DEPLOY_ZINDER_ENV=./profiles/zakura-testnet/zinder.env

# Root-owned host directories; see deploy/README.md and docs/runbooks/deploying-on-a-vm.md.
DEPLOY_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, explorer, and private ops ports (+10000 offset).
DEPLOY_INDEX_OPS_HOST_PORT=19105
DEPLOY_SERVE_OPS_HOST_PORT=19108
DEPLOY_QUERY_HOST_PORT=19102
DEPLOY_COMPAT_HOST_PORT=19067
DEPLOY_EXPLORER_HOST_PORT=19068
DEPLOY_CIPHERSCAN_HOST_PORT=19070

# Observability host ports (+10000 offset).
DEPLOY_PROMETHEUS_HOST_PORT=19095
DEPLOY_GRAFANA_HOST_PORT=13002

# Container memory ceilings (cgroup guardrails).
DEPLOY_INDEX_MEMORY_LIMIT=12g
DEPLOY_SERVE_MEMORY_LIMIT=4g
DEPLOY_PROMETHEUS_MEMORY_LIMIT=1g
DEPLOY_GRAFANA_MEMORY_LIMIT=512m

# Optional overrides (set DEPLOY_INDEX_ENV for writer-only indexer TLS / ingest source):
# DEPLOY_INDEX_ENV=./profiles/zakura-testnet/index.env
# DEPLOY_VERSION=v0.29.0
# DEPLOY_IMAGE=ghcr.io/zcashfoundation/zinder:local
# DEPLOY_GRAFANA_ADMIN_PASSWORD=admin
