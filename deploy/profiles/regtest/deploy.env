# Host and Compose orchestration for Zebra regtest attachment through Z3.
# Use with:
#
#   docker compose --env-file deploy/profiles/regtest/deploy.env -f deploy/docker-compose.yml up -d
#
# Requires Z3 regtest to be running first (the `z3-regtest` external network
# and `z3-regtest-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3.
#
# Z3 regtest disables Zebra's cookie auth, so the paired zinder.env sets
# ZINDER_NODE__AUTH__METHOD=none. The cookie volume mount stays in the compose
# file; it is just not consulted at this auth method.
#
# Host ports are offset by +20000 vs the compose mainnet defaults so the
# regtest flavour coexists with mainnet (no offset) and testnet (+10000).

DEPLOY_NETWORK=regtest
DEPLOY_NODE_NETWORK=z3-regtest
DEPLOY_NODE_COOKIE_VOLUME=z3-regtest-cookie
# Relative env_file paths resolve from deploy/ (where docker-compose.yml lives).
DEPLOY_ZINDER_ENV=./profiles/regtest/zinder.env

# Root-owned host directories; see deploy/README.md and docs/runbooks/deploying-on-a-vm.md.
DEPLOY_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, explorer, and private ops ports (+20000 offset).
DEPLOY_INDEX_OPS_HOST_PORT=29105
DEPLOY_SERVE_OPS_HOST_PORT=29108
DEPLOY_QUERY_HOST_PORT=29102
DEPLOY_COMPAT_HOST_PORT=29067
DEPLOY_EXPLORER_HOST_PORT=29068
DEPLOY_CIPHERSCAN_HOST_PORT=29070

# Observability host ports (+20000 offset).
DEPLOY_PROMETHEUS_HOST_PORT=29095
DEPLOY_GRAFANA_HOST_PORT=23002

# Container memory ceilings (Regtest is small).
DEPLOY_INDEX_MEMORY_LIMIT=4g
DEPLOY_SERVE_MEMORY_LIMIT=2g
DEPLOY_PROMETHEUS_MEMORY_LIMIT=512m
DEPLOY_GRAFANA_MEMORY_LIMIT=512m

# Optional overrides:
# DEPLOY_INDEX_ENV=./profiles/regtest/index.env
# DEPLOY_VERSION=v0.28.0
# DEPLOY_IMAGE=ghcr.io/zcashfoundation/zinder:local
# DEPLOY_GRAFANA_ADMIN_PASSWORD=admin
