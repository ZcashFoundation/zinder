# Zebra regtest attachment through Z3. Use with:
#
#   docker compose --env-file deploy/.env.regtest -f deploy/docker-compose.yml up -d
#
# Requires Z3 regtest to be running first (the `z3-regtest` external network
# and `z3-regtest-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3.
#
# Z3 regtest disables Zebra's cookie auth (the regtest Zebra accepts
# unauthenticated requests from inside the Docker network), so this helper
# overrides ZINDER_NODE__AUTH__METHOD to `none`. The cookie volume mount
# stays in the compose file; it is just not consulted at this auth method.
#
# Host ports are offset by +20000 vs the compose mainnet defaults so the
# regtest flavour coexists with mainnet (no offset) and testnet (+10000).

ZINDER_DEPLOY_NETWORK=regtest
ZINDER_SOURCE_NETWORK_NAME=z3-regtest
ZINDER_SOURCE_COOKIE_VOLUME_NAME=z3-regtest-cookie
ZINDER_NETWORK__NAME=zcash-regtest
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:18232
# Empty selects JSON-RPC mempool polling, so no indexer listener is needed.
ZINDER_NODE__INDEXER_GRPC_ADDR=
ZINDER_NODE__AUTH__METHOD=none
# Stable, non-secret wallet projection lease owner for this deployment lane.
ZINDER_PROJECTOR_BUILD_OWNER_HEX=000000000000000000000000000000c3
# Root-owned host directories; see docs/runbooks/deploying-on-a-vm.md.
ZINDER_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, and private ops ports (+20000 offset).
ZINDER_INGEST_OPS_HOST_PORT=29105
ZINDER_PROJECTOR_OPS_HOST_PORT=29110
ZINDER_QUERY_HOST_PORT=29102
ZINDER_QUERY_OPS_HOST_PORT=29106
ZINDER_COMPAT_HOST_PORT=29067
ZINDER_COMPAT_OPS_HOST_PORT=29107
ZINDER_EXPLORER_HOST_PORT=29068
ZINDER_EXPLORER_OPS_HOST_PORT=29069

# Observability host ports (+20000 offset).
ZINDER_PROMETHEUS_HOST_PORT=29095
ZINDER_GRAFANA_HOST_PORT=23002

# Container memory ceilings. Regtest is small, so the limits are intentionally
# lower while preserving the same cgroup guardrail behavior as public networks.
ZINDER_INGEST_MEMORY_LIMIT=2g
ZINDER_PROJECTOR_MEMORY_LIMIT=2g
ZINDER_QUERY_MEMORY_LIMIT=1g
ZINDER_COMPAT_MEMORY_LIMIT=1g
ZINDER_EXPLORER_MEMORY_LIMIT=1g
ZINDER_PROMETHEUS_MEMORY_LIMIT=512m
ZINDER_GRAFANA_MEMORY_LIMIT=512m
