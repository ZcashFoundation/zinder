# Copy this file to a local path, replace the fixture paths, and pass it with
# `docker compose --env-file`. Relative bind paths resolve from deploy/, where
# docker-compose.storage-benchmark.yml lives.

ZINDER_BENCH_PROJECT_NAME=zinder-storage-benchmark

# Required for every Compose operation. Use a local image ID in
# `sha256:<64-hex>` form or a registry reference pinned with `@sha256:<64-hex>`.
# Mutable tags are not accepted by zinder-bench and must not identify evidence.
# ZINDER_BENCH_IMAGE=

# Every benchmark arm reads the same immutable fixture.
ZINDER_BENCH_FIXTURE_PATH=../fixtures/mainnet-150k-200k

# Create this directory before a run and make it writable by container UID 1000.
ZINDER_BENCH_RESULTS_PATH=../benchmark-results

# Required for every benchmark run. Add concrete values to the copied file;
# the Compose model rejects missing or empty provenance. Change the runner
# identity whenever hardware, storage, resource limits, or database settings
# change, even when the physical host stays the same.
# ZINDER_BENCH_SOFTWARE_REVISION=
# ZINDER_BENCH_RUNNER_ID=
# ZINDER_BENCH_STORAGE_CLASS=
# Unique within one campaign, for example trial-01. Change it before each pair.
# ZINDER_BENCH_TRIAL_ID=
# Use one policy for the entire campaign. The runbook defines both treatments.
# ZINDER_BENCH_FIXTURE_CACHE_POLICY=

ZINDER_BENCH_BLOCK_PREPARE_CONCURRENCY=16
# Resource observers wait this long between cgroup-memory and candidate-volume
# observations. Actual cadence also includes collection and scheduling time;
# keep the configured delay identical for every arm in a formal campaign.
ZINDER_BENCH_RESOURCE_SAMPLE_INTERVAL_SECONDS=1

# Each isolated arm receives an aggregate budget of 8 CPUs and 16 GiB. The
# PostgreSQL client and database limits must sum to its reported arm limits.
ZINDER_BENCH_ROCKSDB_REPLAY_CPUS=8.0
ZINDER_BENCH_ROCKSDB_REPLAY_MEMORY_LIMIT_BYTES=17179869184
ZINDER_BENCH_POSTGRES_TOTAL_CPUS=8.0
ZINDER_BENCH_POSTGRES_TOTAL_MEMORY_LIMIT_BYTES=17179869184
ZINDER_BENCH_POSTGRES_CLIENT_CPUS=2.0
ZINDER_BENCH_POSTGRES_CLIENT_MEMORY_LIMIT_BYTES=8589934592
ZINDER_BENCH_POSTGRES_DATABASE_CPUS=6.0
ZINDER_BENCH_POSTGRES_DATABASE_MEMORY_LIMIT_BYTES=8589934592

# Local-only PostgreSQL endpoint components and intentionally public
# credentials. The Compose service constructs
# ZINDER_BENCH_POSTGRES_DATABASE_URL inside the benchmark client container.
ZINDER_BENCH_POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:1961f96e6029a02c3812d7cb329a3b03a3ac2bb067058dec17b0f5596aca9296
ZINDER_BENCH_POSTGRES_HOST_PORT=55432
ZINDER_BENCH_POSTGRES_DATABASE=zinder_bench
ZINDER_BENCH_POSTGRES_USER=zinder_bench
ZINDER_BENCH_POSTGRES_PASSWORD=zinder_bench_local_only
ZINDER_BENCH_POSTGRES_SHARED_MEMORY_SIZE=2g
ZINDER_BENCH_POSTGRES_TMPFS_SIZE=512m

# PostgreSQL 18 bulk-build settings. Durability remains enabled.
ZINDER_BENCH_POSTGRES_MAX_CONNECTIONS=50
ZINDER_BENCH_POSTGRES_SHARED_BUFFERS=2GB
ZINDER_BENCH_POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
ZINDER_BENCH_POSTGRES_MAINTENANCE_WORK_MEM=1GB
ZINDER_BENCH_POSTGRES_WORK_MEM=64MB
ZINDER_BENCH_POSTGRES_MAX_WAL_SIZE=16GB
ZINDER_BENCH_POSTGRES_MIN_WAL_SIZE=2GB
ZINDER_BENCH_POSTGRES_CHECKPOINT_TIMEOUT=15min
ZINDER_BENCH_POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
ZINDER_BENCH_POSTGRES_WAL_COMPRESSION=on
ZINDER_BENCH_POSTGRES_MAX_WORKER_PROCESSES=6
ZINDER_BENCH_POSTGRES_MAX_PARALLEL_WORKERS=6
ZINDER_BENCH_POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=4
