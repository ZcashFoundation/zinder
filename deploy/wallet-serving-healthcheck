#!/bin/sh

# Container healthcheck for the single-host wallet-serving image.
#
# Healthy means the native query surface answers wallets usefully: it is ready,
# or it refuses every request with the typed REORG_WINDOW_EXCEEDED halt because
# the canonical writer is parked, or it answers unready behind a projector
# parked on a wallet transition over its logical-byte limit. The entrypoint
# deliberately keeps a parked topology up, so an orchestrator that restarts
# unhealthy containers must not replace those refusals with refused
# connections.

set -u

query_ops_addr="${1:-127.0.0.1:9106}"
projector_ops_addr="${2:-127.0.0.1:9110}"

# The image HEALTHCHECK allows five seconds in total, which both probes share.
readiness_body="$(
  curl -s --connect-timeout 2 --max-time 3 \
    -w '\n%{http_code}' \
    "http://$query_ops_addr/readyz"
)" || exit 1

http_status="${readiness_body##*
}"

if [ "$http_status" = "200" ]; then
  exit 0
fi

case "$readiness_body" in
  *'"reorg_window_exceeded"'*)
    exit 0
    ;;
  *) ;;
esac

projector_body="$(
  curl -s --connect-timeout 1 --max-time 1 "http://$projector_ops_addr/readyz"
)" || exit 1

case "$projector_body" in
  *'"wallet_transition_limit_exceeded"'*)
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
