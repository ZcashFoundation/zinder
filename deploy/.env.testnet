# Zebra testnet attachment through Z3. Use with:
#
#   docker compose --env-file deploy/.env.testnet -f deploy/docker-compose.yml up -d
#
# Requires Z3 testnet to be running first (the `z3-testnet` external network
# and `z3-testnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3. For a Zakura node, use
# deploy/.env.zakura-testnet instead; both files describe the same deployment.
#
# Host ports are offset by +10000 vs the compose mainnet defaults so the two
# zinder flavours coexist on one host (mirrors the convention Zebra itself
# uses, 8232 vs 18232, and the offset z3 applies in .env.testnet).

ZINDER_DEPLOY_NETWORK=testnet
ZINDER_SOURCE_NETWORK_NAME=z3-testnet
ZINDER_SOURCE_COOKIE_VOLUME_NAME=z3-testnet-cookie
ZINDER_NETWORK__NAME=zcash-testnet
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:18232
# Empty selects JSON-RPC mempool polling. Stock Z3 does not start Zebra's
# indexer gRPC listener. To stream mempool events instead, set
# ZEBRA_RPC__INDEXER_LISTEN_ADDR=0.0.0.0:8155 in the Z3 .env file and use:
# ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:8155
ZINDER_NODE__INDEXER_GRPC_ADDR=
# Stable, non-secret wallet projection lease owner for this deployment lane.
ZINDER_PROJECTOR_BUILD_OWNER_HEX=000000000000000000000000000000b2
# Root-owned host directories; see docs/runbooks/deploying-on-a-vm.md.
ZINDER_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, and private ops ports (+10000 offset).
ZINDER_INGEST_OPS_HOST_PORT=19105
ZINDER_PROJECTOR_OPS_HOST_PORT=19110
ZINDER_QUERY_HOST_PORT=19102
ZINDER_QUERY_OPS_HOST_PORT=19106
ZINDER_COMPAT_HOST_PORT=19067
ZINDER_COMPAT_OPS_HOST_PORT=19107
ZINDER_EXPLORER_HOST_PORT=19068
ZINDER_EXPLORER_OPS_HOST_PORT=19069

# Observability host ports (+10000 offset).
ZINDER_PROMETHEUS_HOST_PORT=19095
ZINDER_GRAFANA_HOST_PORT=13002

# Container memory ceilings. Testnet usually idles far below these, but
# initial catchup and materialized-view replay should still fail inside the container
# boundary if an application bug escapes the configured replay bounds.
ZINDER_INGEST_MEMORY_LIMIT=8g
ZINDER_PROJECTOR_MEMORY_LIMIT=6g
ZINDER_QUERY_MEMORY_LIMIT=2g
ZINDER_COMPAT_MEMORY_LIMIT=2g
ZINDER_EXPLORER_MEMORY_LIMIT=2g
ZINDER_PROMETHEUS_MEMORY_LIMIT=1g
ZINDER_GRAFANA_MEMORY_LIMIT=512m
