{
	auto_https off
	admin off
	persist_config off
	servers :9067 {
		protocols h1 h2c
	}
}

:8080 {
	reverse_proxy zinder-reader-a:9070 zinder-reader-b:9070 {
		lb_policy round_robin
		lb_retries 0
	}
}

:9067 {
	reverse_proxy zinder-reader-a:9067 zinder-reader-b:9067 {
		lb_policy round_robin
		lb_retries 0
		transport http {
			versions h2c 2
		}
	}
}
