# Zebra mainnet attachment through Z3. Use with:
#
#   docker compose --env-file deploy/.env.mainnet -f deploy/docker-compose.yml up -d
#
# Requires Z3 mainnet to be running first (the `z3-mainnet` external network
# and `z3-mainnet-cookie` external volume must already exist). See:
# https://github.com/ZcashFoundation/z3. For a Zakura node, use
# deploy/.env.zakura-mainnet instead; both files describe the same deployment.
#
# Mainnet uses the canonical (no-offset) host ports from the compose file.
# Testnet adds +10000 (see deploy/.env.testnet); regtest adds +20000.
# Setting them explicitly here documents the canonical port matrix.

ZINDER_DEPLOY_NETWORK=mainnet
ZINDER_SOURCE_NETWORK_NAME=z3-mainnet
ZINDER_SOURCE_COOKIE_VOLUME_NAME=z3-mainnet-cookie
ZINDER_NETWORK__NAME=zcash-mainnet
ZINDER_NODE__JSON_RPC_ADDR=http://zebra:8232
# Empty selects JSON-RPC mempool polling. Stock Z3 does not start Zebra's
# indexer gRPC listener. To stream mempool events instead, set
# ZEBRA_RPC__INDEXER_LISTEN_ADDR=0.0.0.0:8155 in the Z3 .env file and use:
# ZINDER_NODE__INDEXER_GRPC_ADDR=http://zebra:8155
ZINDER_NODE__INDEXER_GRPC_ADDR=

# Stable, non-secret wallet projection lease owner for this deployment lane.
ZINDER_PROJECTOR_BUILD_OWNER_HEX=000000000000000000000000000000a1
# Root-owned host directories; see docs/runbooks/deploying-on-a-vm.md.
ZINDER_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, and private ops ports (canonical, no offset).
ZINDER_INGEST_OPS_HOST_PORT=9105
ZINDER_PROJECTOR_OPS_HOST_PORT=9110
ZINDER_QUERY_HOST_PORT=9102
ZINDER_QUERY_OPS_HOST_PORT=9106
ZINDER_COMPAT_HOST_PORT=9067
ZINDER_COMPAT_OPS_HOST_PORT=9107
ZINDER_EXPLORER_HOST_PORT=9068
ZINDER_EXPLORER_OPS_HOST_PORT=9069

# Observability host ports (canonical, no offset).
ZINDER_PROMETHEUS_HOST_PORT=9095
ZINDER_GRAFANA_HOST_PORT=3002

# Container memory ceilings. These are cgroup guardrails, not throughput
# controls; replay and commit work must remain bounded in the application.
ZINDER_INGEST_MEMORY_LIMIT=14g
ZINDER_PROJECTOR_MEMORY_LIMIT=10g
ZINDER_QUERY_MEMORY_LIMIT=4g
ZINDER_COMPAT_MEMORY_LIMIT=4g
ZINDER_EXPLORER_MEMORY_LIMIT=4g
ZINDER_PROMETHEUS_MEMORY_LIMIT=1g
ZINDER_GRAFANA_MEMORY_LIMIT=512m
