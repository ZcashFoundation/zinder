# Zakura mainnet attachment. Use with:
#
#   docker compose --env-file deploy/.env.zakura-mainnet -f deploy/docker-compose.yml up -d
#
# This file and deploy/.env.mainnet describe the same Zinder mainnet deployment:
# the Compose project, volumes, host ports, and projector owner are shared, so
# switching nodes keeps the existing stores.
#
# Zakura's own Compose file shares neither a network nor a cookie volume with
# other projects. Start the node with:
#
# - ZAKURA_RPC__LISTEN_ADDR=0.0.0.0:8232, with the node attached to an
#   external Docker network shared with Zinder and reachable there as `zakura`.
# - ZAKURA_RPC__COOKIE_DIR=/var/run/auth on a dedicated named volume. Stock
#   Zakura keeps the cookie in its chain-state volume, which Zinder must not
#   mount.
# - network.zakura.listen_addr (ZAKURA_NETWORK__ZAKURA__LISTEN_ADDR) set
#   deliberately. When it is unset, Zakura's QUIC peer listener binds
#   0.0.0.0:8234.
#
# Zakura writes the cookie as UID 10001 with mode 0600, and Zinder runs as UID
# 1000. Run deploy/node-cookie-permissions.yml with this env file so Zinder can
# read the cookie:
#
#   docker compose --env-file deploy/.env.zakura-mainnet -f deploy/node-cookie-permissions.yml up -d
#
# Mainnet uses the canonical (no-offset) host ports from the compose file.

ZINDER_DEPLOY_NETWORK=mainnet
# Set these two names to the ones the node uses.
ZINDER_SOURCE_NETWORK_NAME=zakura-mainnet
ZINDER_SOURCE_COOKIE_VOLUME_NAME=zakura-mainnet-cookie
ZINDER_NETWORK__NAME=zcash-mainnet
ZINDER_NODE__JSON_RPC_ADDR=http://zakura:8232
# Empty selects JSON-RPC mempool polling. Zakura refuses a plaintext indexer
# gRPC listener on a non-loopback address, so a Zakura node in another
# container can serve the indexer stream only over TLS.
ZINDER_NODE__INDEXER_GRPC_ADDR=

# Stable, non-secret wallet projection lease owner for this deployment lane.
ZINDER_PROJECTOR_BUILD_OWNER_HEX=000000000000000000000000000000a1
# Root-owned host directories; see docs/runbooks/deploying-on-a-vm.md.
ZINDER_CONTROL_SECRETS_DIR=/etc/zinder/control-secrets

# Native query, compatibility, and private ops ports (canonical, no offset).
ZINDER_INGEST_OPS_HOST_PORT=9105
ZINDER_PROJECTOR_OPS_HOST_PORT=9110
ZINDER_QUERY_HOST_PORT=9102
ZINDER_QUERY_OPS_HOST_PORT=9106
ZINDER_COMPAT_HOST_PORT=9067
ZINDER_COMPAT_OPS_HOST_PORT=9107
ZINDER_EXPLORER_HOST_PORT=9068
ZINDER_EXPLORER_OPS_HOST_PORT=9069

# Observability host ports (canonical, no offset).
ZINDER_PROMETHEUS_HOST_PORT=9095
ZINDER_GRAFANA_HOST_PORT=3002

# Container memory ceilings. These are cgroup guardrails, not throughput
# controls; replay and commit work must remain bounded in the application.
ZINDER_INGEST_MEMORY_LIMIT=14g
ZINDER_PROJECTOR_MEMORY_LIMIT=10g
ZINDER_QUERY_MEMORY_LIMIT=4g
ZINDER_COMPAT_MEMORY_LIMIT=4g
ZINDER_EXPLORER_MEMORY_LIMIT=4g
ZINDER_PROMETHEUS_MEMORY_LIMIT=1g
ZINDER_GRAFANA_MEMORY_LIMIT=512m
