# Build artifacts and scratch state never belong in the build context.
target/
.tmp/
mutants.out/
mutants.out.old/
*.rocksdb/
*.zinder-store/
*.profraw
coverage/
lcov.info

# Storage-benchmark corpora and reports are bind-mounted runtime data. Keeping
# the repository-root paths out of the build context prevents multi-gigabyte
# fixtures and checkpoints from being uploaded to BuildKit.
/fixtures/
/benchmark-results/

# Local IDE and shell state.
.git/
.gitignore
.vscode/
.idea/

# Documentation and plans are not used by the runtime image.
docs/
plans/
observability/

# Dockerfiles and deploy assets do not need to ship inside images, with the
# exception of the runtime entrypoints, the healthcheck, and the baked config
# that deploy/Dockerfile copies into runtime images. The build fails when a
# copied file is excluded, and build-images.yml builds every such target.
**/Dockerfile
**/Dockerfile.*
deploy/
!deploy/capture-container-resource-evidence.sh
!deploy/canonical-runtime-entrypoint
!deploy/materialize-indexer-tls
!deploy/wallet-serving-runtime-entrypoint
!deploy/wallet-serving-healthcheck
!deploy/config/wallet-serving/
!deploy/config/wallet-serving/**

# Test outputs.
**/test-results/
**/junit.xml
